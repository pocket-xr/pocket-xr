+// Copyright 2026, Pocket XR contributors.
+// SPDX-License-Identifier: BSL-1.0
+package org.freedesktop.monado.ipc;
+
+import androidx.annotation.Keep;
+
+/** The Pocket XR app's way into the pocketxr driver: the display it reports and the head's pose. */
+@Keep
+public final class PocketFeed {
+    static {
+        System.loadLibrary(BuildConfig.SERVICE_LIB_NAME);
+    }
+
+    private PocketFeed() {}
+
+    /** Before the runtime starts: the display, and one eye's field of view as half-angle tangents. */
+    public static native void nativeConfigure(
+            int widthPx, int heightPx, float refreshHz, float tanHalfX, float tanHalfY);
+
+    /**
+     * Before the runtime starts: the wearer's IPD in metres (0 keeps the application's), and each eye's view centre
+     * turned outward by this tangent, (IPD / 2) / the glasses' 3D distance, so depth matches their converged optics.
+     */
+    public static native void nativeConfigureEyes(float ipdM, float eyeShiftTan);
+
+    /**
+     * The display's latest real vblank on System.nanoTime and its measured period, so Monado's pacer locks to the
+     * display. A period of 0 gives the pacer back its own clock.
+     */
+    public static native void nativeVblank(long lastVblankNs, long periodNs);
+
+    /** One head pose on System.nanoTime, head to world, with angular velocity in the world frame. */
+    public static native void nativePose(
+            long timestampNs, float x, float y, float z, float w, float angX, float angY, float angZ);
+
+    /**
+     * One head pose with a position (6DoF glasses), on System.nanoTime: position in metres from where tracking
+     * started, orientation head to world, angular velocity (rad/s) and velocity (m/s) in the world frame. While
+     * [positionTracked] is false the position is held: valid, not tracked.
+     */
+    public static native void nativePose6(
+            long timestampNs,
+            float px,
+            float py,
+            float pz,
+            float x,
+            float y,
+            float z,
+            float w,
+            float angX,
+            float angY,
+            float angZ,
+            float velX,
+            float velY,
+            float velZ,
+            boolean positionTracked);
+
+    /**
+     * One controller state: hand 0 left, 1 right, at the sample's own time. Position in metres, orientation with y up and
+     * -z forward, angular velocity (rad/s) and velocity (m/s) in the world frame. Buttons: 1 primary, 2 secondary,
+     * 4 menu, 8 stick click; touches 0x10 primary, 0x20 secondary, 0x40 trigger, 0x80 stick, 0x100 thumb rest.
+     */
+    public static native void nativeController(
+            int hand,
+            long timestampNs,
+            float px,
+            float py,
+            float pz,
+            float x,
+            float y,
+            float z,
+            float w,
+            float angX,
+            float angY,
+            float angZ,
+            float velX,
+            float velY,
+            float velZ,
+            int buttons,
+            float trigger,
+            float squeeze,
+            float stickX,
+            float stickY);
+}
