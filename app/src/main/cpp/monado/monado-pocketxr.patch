+// Copyright 2026, Pocket XR contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  A head mounted display whose pose and optics are fed in by the Pocket XR app.
+ * @ingroup drv_pocketxr
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct xrt_auto_prober;
+
+//! The auto prober that makes the one device.
+struct xrt_auto_prober *
+pocketxr_create_auto_prober(void);
+
+/*!
+ * The display the device reports. Takes effect when the device is made, so call it before the server starts.
+ *
+ * @param width_px   The whole display, both eyes when it is side by side.
+ * @param height_px  The display's height.
+ * @param refresh_hz The display's refresh rate.
+ * @param tan_half_x Tangent of half the horizontal field of view of one eye.
+ * @param tan_half_y Tangent of half the vertical field of view of one eye.
+ */
+void
+pocketxr_configure(int32_t width_px, int32_t height_px, float refresh_hz, float tan_half_x, float tan_half_y);
+
+/*!
+ * The display's latest real vblank, on CLOCK_MONOTONIC, and its measured period, so the compositor's pacer locks to
+ * the display instead of a nominal clock. Any thread. A period of 0 hands the pacer back its own clock.
+ */
+void
+pocketxr_feed_vblank(int64_t last_vblank_ns, int64_t period_ns);
+
+/*!
+ * Before the runtime starts: the wearer's IPD in metres (0 keeps the application's), and how far each eye's view centre
+ * turns outward as a tangent, (IPD / 2) / the glasses' 3D distance, so depth matches the glasses' converged optics.
+ */
+void
+pocketxr_configure_eyes(float ipd_m, float eye_shift_tan);
+
+/*!
+ * One head pose, on CLOCK_MONOTONIC. Any thread. Dropped when no device exists yet.
+ *
+ * @param timestamp_ns When the pose is true.
+ * @param x,y,z,w      The head's orientation, head to world, y up and -z forward.
+ * @param ang_x,ang_y,ang_z Angular velocity in the world frame, radians per second.
+ */
+void
+pocketxr_feed_pose(
+    int64_t timestamp_ns, float x, float y, float z, float w, float ang_x, float ang_y, float ang_z);
+
+/*!
+ * One head pose with a position, from glasses with 6DoF tracking, on CLOCK_MONOTONIC. Any thread. Dropped when no
+ * device exists yet.
+ *
+ * @param timestamp_ns When the pose is true.
+ * @param px,py,pz     The head's position in metres, y up and -z forward, from where tracking started.
+ * @param x,y,z,w      The head's orientation, head to world, y up and -z forward.
+ * @param ang_x,ang_y,ang_z Angular velocity in the world frame, radians per second.
+ * @param vel_x,vel_y,vel_z Linear velocity in the world frame, metres per second.
+ * @param position_tracked 0 while the position is held (tracking unsure), else 1.
+ */
+void
+pocketxr_feed_pose6(int64_t timestamp_ns,
+                    float px,
+                    float py,
+                    float pz,
+                    float x,
+                    float y,
+                    float z,
+                    float w,
+                    float ang_x,
+                    float ang_y,
+                    float ang_z,
+                    float vel_x,
+                    float vel_y,
+                    float vel_z,
+                    int position_tracked);
+
+/*!
+ * One controller state, on CLOCK_MONOTONIC. Any thread. Dropped when no device exists yet.
+ *
+ * @param hand         0 left, 1 right.
+ * @param timestamp_ns When the state is true.
+ * @param px,py,pz     The grip's position in the head's space, metres.
+ * @param x,y,z,w      The grip's orientation, y up and -z forward.
+ * @param ang_x,ang_y,ang_z Angular velocity in the world frame, radians per second.
+ * @param buttons      Bit 0 A or X, bit 1 B or Y, bit 2 menu or system, bit 3 stick click.
+ * @param trigger,squeeze 0 to 1.
+ * @param stick_x,stick_y -1 to 1, up positive.
+ */
+void
+pocketxr_feed_controller(int32_t hand,
+                         int64_t timestamp_ns,
+                         float px,
+                         float py,
+                         float pz,
+                         float x,
+                         float y,
+                         float z,
+                         float w,
+                         float ang_x,
+                         float ang_y,
+                         float ang_z,
+                         float vel_x,
+                         float vel_y,
+                         float vel_z,
+                         uint32_t buttons,
+                         float trigger,
+                         float squeeze,
+                         float stick_x,
+                         float stick_y);
+
+#ifdef __cplusplus
+}
+#endif
