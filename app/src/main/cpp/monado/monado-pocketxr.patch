diff --git a/src/xrt/auxiliary/util/u_pacing_compositor_fake.c b/src/xrt/auxiliary/util/u_pacing_compositor_fake.c
index f7589a3e0..16e2ae212 100644
--- a/src/xrt/auxiliary/util/u_pacing_compositor_fake.c
+++ b/src/xrt/auxiliary/util/u_pacing_compositor_fake.c
@@ -22,6 +22,7 @@
 #include <stdio.h>
 #include <assert.h>
 #include <math.h>
+#include <stdatomic.h>
 
 DEBUG_GET_ONCE_LOG_OPTION(log_level_fake, "U_PACING_COMPOSITOR_FAKE_LOG", U_LOGGING_INFO)
 
@@ -175,9 +176,48 @@ get_new_frame(struct fake_timing *ft)
 	return f;
 }
 
+/*
+ * Pocket XR: the display's real vblank, fed from outside (u_pc_fake_external_vblank).
+ */
+static _Atomic int64_t g_external_vblank_ns = 0;
+static _Atomic int64_t g_external_period_ns = 0;
+static _Atomic int64_t g_external_used = 0;
+
+#define EXTERNAL_VBLANK_MAX_AGE_NS (500 * U_TIME_1MS_IN_NS)
+
+void
+u_pc_fake_external_vblank(int64_t last_vblank_ns, int64_t period_ns)
+{
+	atomic_store(&g_external_period_ns, period_ns);
+	atomic_store(&g_external_vblank_ns, period_ns > 0 ? last_vblank_ns : 0);
+}
+
+//! Takes the fed vblank and period when one is fresh and sane.
+static void
+apply_external_vblank(struct fake_timing *ft, int64_t now_ns)
+{
+	int64_t vblank_ns = atomic_load(&g_external_vblank_ns);
+	int64_t period_ns = atomic_load(&g_external_period_ns);
+	bool fresh = vblank_ns > 0 && now_ns - vblank_ns < EXTERNAL_VBLANK_MAX_AGE_NS;
+	bool sane = period_ns > 2 * U_TIME_1MS_IN_NS && period_ns < 50 * U_TIME_1MS_IN_NS;
+	if (!fresh || !sane) {
+		if (atomic_exchange(&g_external_used, 0) != 0) {
+			U_LOG_I("Pocket XR: no fresh display vblank, the pacer keeps its own clock");
+		}
+		return;
+	}
+	if (atomic_exchange(&g_external_used, 1) == 0) {
+		U_LOG_I("Pocket XR: pacing to the display's real vblank, period %.4fms (was %.4fms)",
+		        time_ns_to_ms_f(period_ns), time_ns_to_ms_f(ft->frame_period_ns));
+	}
+	ft->last_present_time_ns = vblank_ns;
+	ft->frame_period_ns = period_ns;
+}
+
 static int64_t
 predict_next_frame_present_time(struct fake_timing *ft, int64_t now_ns)
 {
+	apply_external_vblank(ft, now_ns);
 	int64_t time_needed_ns = ft->comp_time_ns;
 	int64_t period_ns = ft->frame_period_ns;
 	int64_t predicted_present_time_ns = ft->last_present_time_ns + period_ns;
