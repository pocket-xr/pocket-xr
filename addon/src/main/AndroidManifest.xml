<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1.1.0: only an app signed with the same key may bind the link. The app declares the same permission, so it is
         granted whichever of the two is installed first. -->
    <permission
        android:name="com.hayeco.flipspaces.permission.ADDON_LINK"
        android:label="@string/addon_link_permission_label"
        android:protectionLevel="signature" />

    <!-- The app names on the Notifications page (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 1.1.11 (Google Play): the add-on's own screen, the disclosure and consent before either service below is
             switched on. Pocket XR opens it at one of them; the launcher shows both. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What Pocket XR binds: the calls into the two services below. -->
        <service
            android:name=".LinkService"
            android:exported="true"
            android:permission="com.hayeco.flipspaces.permission.ADDON_LINK" />

        <!-- Draws the cursor on the glasses, reads where windows are there and performs taps
             and drags on that display, for Pocket XR. -->
        <service
            android:name=".PointerAccess"
            android:exported="true"
            android:label="@string/pointer_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pointer_service" />
        </service>

        <!-- The Space's Notifications page and which apps play media; Android binds it once notification access is on. -->
        <service
            android:name=".NotesListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
